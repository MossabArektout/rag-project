# API Keys (DO NOT commit actual keys)
GROQ_API_KEY=your_groq_api_key_here

# Application Settings
APP_NAME=Smart Internship Assistant
APP_VERSION=1.0.0
DEBUG=True

# Paths
UPLOAD_FOLDER=./uploads
CHROMA_DB_PATH=./chroma_db
LOG_PATH=./logs

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Hybrid Search (BM25 + semantic, fused via Reciprocal Rank Fusion)
USE_HYBRID_SEARCH=True
HYBRID_CANDIDATE_POOL_SIZE=20
RRF_K=60

# LLM Configuration
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500

# Database
CHROMA_COLLECTION_NAME=company_knowledge