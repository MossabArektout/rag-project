# API Keys (DO NOT commit actual keys)
# OPENAI_API_KEY=sk-your-openai-key-here  # Not needed - using Gemini
GOOGLE_API_KEY=your_google_gemini_key_here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Application Settings
APP_NAME=Smart Internship Assistant
APP_VERSION=1.0.0
DEBUG=True

# Paths
UPLOAD_FOLDER=./uploads
CHROMA_DB_PATH=./chroma_db
LOG_PATH=./logs

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# LLM Configuration
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500

# Database
CHROMA_COLLECTION_NAME=company_knowledge